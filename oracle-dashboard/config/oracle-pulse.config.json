        "kind": "wezterm-spawn",
        "newWindow": true,
        "variants": {
          "localWin": "pwsh -NoLogo -NoExit -Command \"ssh -t nat@white.local 'tmux a -t 24-apollo'\"",
          "localUnix": "ssh -t nat@white.local 'tmux a -t 24-apollo'",
          "wsl": "ssh -t nat@white.local 'tmux a -t 24-apollo'",
          "vps": "ssh -t nat@white.local 'tmux a -t 24-apollo'"
        }
      }
    ],
    "mother": [
