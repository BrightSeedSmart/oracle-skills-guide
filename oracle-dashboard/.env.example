# --- ลำดับตั้งค่าแนะนำ: ดู config/PULSE-SETUP.md ---
#
# Supabase — https://supabase.com/dashboard/project/alqosvxszammxedqefec/settings/api
# SUPABASE_URL=https://alqosvxszammxedqefec.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# ORACLE_SOURCE=pc        # 'pc' สำหรับเครื่องนี้, 'vps' สำหรับ Ariadne
#
# Claude (แท็บ Agents)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Secret ร่วมสำหรับ bridge + POST /api/pulse/send-to-agent (แนะนำถ้าเปิดบน LAN)
# ORACLE_PULSE_BRIDGE_SECRET=

# Config รวม (ค่าเริ่ม: config/oracle-pulse.config.json) — หรือชี้ไฟล์ลับนอก repo
# ORACLE_PULSE_CONFIG_PATH=F:\path\to\oracle-pulse.config.local.json
# หรือใช้ชื่อเดิมได้: WEZTERM_BRIDGE_SECRET=

# WezTerm (แท็บ Mission → WezTerm)
WEZTERM_BRIDGE_ENABLED=1
# WEZTERM_BIN=C:\Program Files\WezTerm\wezterm.exe
# WEZTERM_PREFER_MUX=1

# tmux + SSH (แท็บ Mission → tmux) — ดึง pane บน remote ผ่าน ssh … -- tmux …
TMUX_BRIDGE_ENABLED=1
# TMUX_BIN=tmux
# ORACLE_SSH_TARGET=user@remote-host
# ORACLE_SSH_IDENTITY=C:\Users\You\.ssh\id_ed25519
# ORACLE_SSH_EXTRA_ARGS=-o StrictHostKeyChecking=accept-new
# SSH_BIN=ssh
